# Provider principal: groq ou ollama
LLM_PROVIDER=groq

# Fallback opcional. Para desativar, mantenha a linha comentada (não deixe vazia).
# LLM_FALLBACK_PROVIDER=ollama

# Groq
GROQ_API_KEY=
GROQ_MODEL=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Limites
LLM_TIMEOUT=10
LLM_MAX_TOKENS=160
